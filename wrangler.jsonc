// Cloudflare Workers deploy for the Salena-Jo's site.
// `npx wrangler deploy` runs the build command first, then uploads the static export in web/out.
// The Cloudflare build's root directory must be the repo root ("/").
{
  "name": "salena-jos-website",
  "compatibility_date": "2025-10-01",
  "build": {
    "command": "cd web && npm ci && npm run build"
  },
  "assets": {
    "directory": "./web/out",
    "not_found_handling": "404-page"
  }
}
